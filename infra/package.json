    "destroy": "cdk destroy MeishiAppProdStack --force",
    "bootstrap": "cdk bootstrap"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "aws-cdk": "2.158.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.158.0",
    "constructs": "10.3.0",
    "source-map-support": "0.5.21"
  }
}
